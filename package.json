{
  "name": "@jrhuebers/pi-codex-subagents",
  "version": "0.3.5",
  "description": "Codex-shaped, session-scoped subagents for Pi with templates, waits, steering, and a live overlay.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "subagents",
    "codex",
    "multi-agent",
    "coding-agent"
  ],
  "author": "Can Celik",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jrhuebers/pi-codex-subagents.git"
  },
  "bugs": {
    "url": "https://github.com/jrhuebers/pi-codex-subagents/issues"
  },
  "homepage": "https://github.com/jrhuebers/pi-codex-subagents#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=0.80.4",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "core.ts",
    "peek.ts",
    "picker.ts",
    "wait.ts",
    "transcript.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/run-tests.mjs",
    "test:rpc": "node test/rpc-smoke.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.99.2",
    "@earendil-works/pi-coding-agent": "0.99.2",
    "@earendil-works/pi-tui": "0.99.2",
    "typebox": "1.1.38",
    "bun": "1.4.3"
  },
  "allowScripts": {
    "bun@1.4.3": true
  }
}
